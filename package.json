{
  "name": "relay-dsh-plugin-skill-creator",
  "version": "0.1.2",
  "description": "A DSH plugin that turns a completed conversation into a reusable, validated DSH Skill bundle.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "skill-creator",
    "conversation-to-skill"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-skill-creator.git"
  },
  "homepage": "https://github.com/yangbobo2021/relay-dsh-plugin-skill-creator#readme",
  "bugs": {
    "url": "https://github.com/yangbobo2021/relay-dsh-plugin-skill-creator/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SPEC.md",
    "LICENSE",
    "docs",
    "skills",
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:validator": "node --test test/validator.test.mjs",
    "acceptance": "node scripts/accept-package.mjs",
    "verify": "npm run typecheck && npm test && npm run acceptance"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
